+// One camera of this node. Every camera has its own connection to the simulator, because a request blocks until
+// its image is rendered: asking for the cameras one after the other puts them in different renders (measured:
+// 6.5 images per second per camera and no pair from the same render), asking for all of them at once puts them in
+// the same render (18 per second, 99% of the pairs).
+struct CameraStream
+{
+    std::string name;
+    std::string frame_id;
+    double fov_degrees = 90.0;
+    bool depthcamera = false;
+    std::unique_ptr<msr::airlib::CarRpcLibClient> client;
+    rclcpp::Publisher<sensor_msgs::msg::Image>::SharedPtr image_pub;
+    rclcpp::Publisher<sensor_msgs::msg::CameraInfo>::SharedPtr info_pub;
+};
+
+// Lets every camera thread start its request in the same round.
+class RoundBarrier
+{
+public:
+    explicit RoundBarrier(unsigned count) : count_(count), waiting_(0), round_(0) {}
+
+    void wait()
+    {
+        std::unique_lock<std::mutex> lock(mutex_);
+        const unsigned round = round_;
+        if (++waiting_ == count_) {
+            waiting_ = 0;
+            ++round_;
+            condition_.notify_all();
+        } else {
+            condition_.wait(lock, [this, round] { return round_ != round || stopped_; });
+        }
+    }
+
+    void stop()
+    {
+        std::unique_lock<std::mutex> lock(mutex_);
+        stopped_ = true;
+        condition_.notify_all();
+    }
+
+private:
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    unsigned count_;
+    unsigned waiting_;
+    unsigned round_;
+    bool stopped_ = false;
+};
