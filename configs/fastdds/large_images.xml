<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile for the raw 1280x960 camera images (3.7 MB each), used by record_run.sh and the replay scripts
  through FASTRTPS_DEFAULT_PROFILES_FILE.

  Between processes on one machine Fast DDS uses shared memory, by default with a 512 KB segment and 64 KB messages,
  so every image travels in about 57 fragments and a best effort subscriber loses the whole image when one of them
  is overwritten. A 32 MB segment with messages up to 8 MB carries an image in one piece: the time from the bridge
  publishing an image to the node having it went from 10.7 to 2.1 ms at p95.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <maxMessageSize>8388608</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="large_images" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
